# ===========================================
# GIPIS Institucional - Environment Variables
# ===========================================

# Dominio del sitio (sin https://)
DOMAIN=gipis.unp.edu.ar

# Email para Let's Encrypt (notificaciones de expiración SSL)
ACME_EMAIL=admin@unp.edu.ar

# Clave secreta para Flask (generar con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia-esta-clave-en-produccion-con-algo-seguro

# Entorno
FLASK_ENV=production

# Email SMTP (Gmail) — Ver CONTACTO_SETUP.md para instrucciones
MAIL_USERNAME=gipis.unp@gmail.com
MAIL_PASSWORD=tu-app-password-de-gmail-aqui

# Umami Analytics — Ver UMAMI_SETUP.md para instrucciones
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=/umami/script.js
UMAMI_DB_PASSWORD=cambiar-en-produccion
UMAMI_APP_SECRET=cambiar-en-produccion
